# Where the gateway lives, and how this plugin authenticates to it.
# host.docker.internal works from inside Docker on Mac/Windows when the
# gateway itself is running outside of Docker; use the gateway's real
# reachable address in production.
LIVEHOST_GATEWAY_URL=http://host.docker.internal:8000
LIVEHOST_PLUGIN_NAME=livehost
# The shared secret set when the plugin was registered with the gateway
# (POST /v1/plugins) -- see that response's "secret" field.
LIVEHOST_PLUGIN_SECRET=

LIVEHOST_HOST=0.0.0.0
LIVEHOST_PORT=8091

# Carried over verbatim from the gateway's own tuning knobs.
LIVEHOST_MENTION_KEYWORDS=
LIVEHOST_INDIVIDUAL_THRESHOLD=3
LIVEHOST_BATCH_TOP_K=3
LIVEHOST_QUEUE_MAX_SIZE=200
LIVEHOST_BACKOFF_INITIAL_SECONDS=1.0
LIVEHOST_BACKOFF_MAX_SECONDS=60.0
LIVEHOST_OFFLINE_POLL_INTERVAL_SECONDS=30.0
LIVEHOST_WATCHDOG_IDLE_SECONDS=300.0
